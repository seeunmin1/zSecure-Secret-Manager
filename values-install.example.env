# ---------------------------------------------------------------------------
# STAGE 2 values -- YOUR install. Replace every <ANGLE BRACKET> below.
#
# Six of these are real decisions, not lookups. See the README.
# ---------------------------------------------------------------------------

# existing | new-shared-global | new-dedicated-global
# Are you installing into an SMP/E environment that already exists, or building
# one? If unsure, ask whoever owns SMP/E on the system -- do not guess.
SMPEENV=new-dedicated-global

# WHERE THE PRODUCT COMES FROM (read-only input to RECEIVE).
# Ask whoever staged the Shopz order. Confirm it exists:
#   python3 zsmagent.py preflight --values values-install.env
ORDERPFX=<ORDER.PREFIX>

# WHERE THE INSTALL GOES. Must be unused. GLOBALPFX must differ from TARGETPFX.
TARGETPFX=<YOURID>.BRS320
GLOBALPFX=<YOURID>.BRS320.G
ZFSNAME=<YOURID>.BRS320.ZFS

# zFS MOUNT POINT -- this is a PERMISSIONS decision, not just a path.
#   under your own home  -> no special authority needed
#   under /usr/lpp/...   -> needs UID 0 or READ on SUPERUSER.FILESYS.PFSCTL
# Keep it SHORT. Long values push the sample jobs' comment lines past the
# 80-byte record limit; the agent will tell you by how much if so.
PATHPFX=/home/<yourid>/t1/

# Disk volume, and it needs ~380 cylinders free. Nothing checks this for you.
VOLSER=<VOLSER>
UNIT=SYSALLDA

# SMP/E zone names. MUST be unique on the system -- duplicates cause rework
# that surfaces phases later.
TZONE=<ZONE>T
DZONE=<ZONE>D

# Site conventions -- ask, don't invent.
ACCT=<ACCOUNT>
PROGRAMMER=<YOUR.NAME>
JOBCLASS=A
MSGCLASS=X
